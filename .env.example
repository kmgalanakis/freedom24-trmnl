# Copy to .env and fill in your Freedom24 API keys (Profile → API keys).
F24_PUBLIC_KEY=
F24_PRIVATE_KEY=

# Currency label shown on the Kindle (values are converted with Freedom24's own rates).
BASE_CURRENCY=USD

# Seconds to reuse the last answer before asking Freedom24 again.
CACHE_SECONDS=300

# Set to 1 temporarily to expose /raw for debugging field names.
DEBUG=0
