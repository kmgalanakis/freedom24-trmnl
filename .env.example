# Copy this file to .env and fill in your Freedom24 API keys.
# Generate them at https://freedom24.com/tradernet-api/auth-api after you sign in.
# The keys can place trades, so never commit .env.
F24_PUBLIC_KEY=
F24_PRIVATE_KEY=

# Currency for all totals. Your account needs a cash row in this currency.
BASE_CURRENCY=USD

# Seconds to reuse the last Freedom24 answer before asking again.
CACHE_SECONDS=300

# Time zone for the "updated" time, for example Europe/London.
TZ=UTC

# Set to 1 only while debugging. It exposes your full account data at /raw.
DEBUG=0
